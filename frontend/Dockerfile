FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=http://127.0.0.1:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_AUTH_MODE=oidc
ARG VITE_AUTH_DEVELOPMENT_TOKEN
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_AUDIENCE
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_OIDC_SCOPE="openid profile email"
ARG VITE_OIDC_CONNECTION_PARAMETER=connection
ARG VITE_OIDC_GITHUB_CONNECTION
ARG VITE_OIDC_GOOGLE_CONNECTION
ARG VITE_OIDC_EMAIL_CONNECTION
ARG VITE_GITHUB_CONNECT_URL
ARG VITE_GITLAB_CONNECT_URL
ARG VITE_BITBUCKET_CONNECT_URL
ENV VITE_AUTH_MODE=$VITE_AUTH_MODE
ENV VITE_AUTH_DEVELOPMENT_TOKEN=$VITE_AUTH_DEVELOPMENT_TOKEN
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_AUDIENCE=$VITE_OIDC_AUDIENCE
ENV VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI
ENV VITE_OIDC_SCOPE=$VITE_OIDC_SCOPE
ENV VITE_OIDC_CONNECTION_PARAMETER=$VITE_OIDC_CONNECTION_PARAMETER
ENV VITE_OIDC_GITHUB_CONNECTION=$VITE_OIDC_GITHUB_CONNECTION
ENV VITE_OIDC_GOOGLE_CONNECTION=$VITE_OIDC_GOOGLE_CONNECTION
ENV VITE_OIDC_EMAIL_CONNECTION=$VITE_OIDC_EMAIL_CONNECTION
ENV VITE_GITHUB_CONNECT_URL=$VITE_GITHUB_CONNECT_URL
ENV VITE_GITLAB_CONNECT_URL=$VITE_GITLAB_CONNECT_URL
ENV VITE_BITBUCKET_CONNECT_URL=$VITE_BITBUCKET_CONNECT_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
