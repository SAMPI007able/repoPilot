VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://your-identity-provider.example.com/
VITE_OIDC_CLIENT_ID=testforge-web
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_OIDC_SCOPE=openid profile email

# Local-only alternative; must match backend AUTH_DEVELOPMENT_TOKEN.
# VITE_AUTH_MODE=development
# VITE_AUTH_DEVELOPMENT_TOKEN=replace-with-a-local-random-value
