VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://your-identity-provider.example.com/
VITE_OIDC_CLIENT_ID=testforge-web
VITE_OIDC_AUDIENCE=https://api.testforge.example.com
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_OIDC_SCOPE=openid profile email
# Optional identity-provider connection hints. These are Auth0 defaults; adjust for your OIDC provider.
VITE_OIDC_CONNECTION_PARAMETER=connection
VITE_OIDC_GITHUB_CONNECTION=github
VITE_OIDC_GOOGLE_CONNECTION=google-oauth2
VITE_OIDC_EMAIL_CONNECTION=Username-Password-Authentication

# Backend-owned OAuth/GitHub App installation entry points. Leave blank until each integration is configured.
VITE_GITHUB_CONNECT_URL=
VITE_GITLAB_CONNECT_URL=
VITE_BITBUCKET_CONNECT_URL=

# Local-only alternative; must match backend AUTH_DEVELOPMENT_TOKEN.
# VITE_AUTH_MODE=development
# VITE_AUTH_DEVELOPMENT_TOKEN=replace-with-a-local-random-value
