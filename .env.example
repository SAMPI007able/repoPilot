# TestForge environment contract
# Copy this file to .env for local development. Production values belong in
# the Vercel and Railway/Fly environment dashboards, never in committed files.

# -----------------------------------------------------------------------------
# Shared public origins
# -----------------------------------------------------------------------------
APP_ENV=development
PORT=8000
FRONTEND_URL=http://127.0.0.1:5173
OAUTH_CALLBACK_BASE_URL=http://127.0.0.1:8000
# Comma-separated, exact browser origins. Do not use * with bearer auth.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# Backend: AI, database, Redis, and artifacts
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Local direct-run default. Docker Compose overrides this with its PostgreSQL URL.
DATABASE_URL=sqlite:///backend/workspace/testforge.db
REDIS_URL=redis://127.0.0.1:6379/0

ARTIFACT_STORE=local
ARTIFACT_LOCAL_ROOT=backend/workspace/artifacts
# Production AWS S3 settings; required when ARTIFACT_STORE=s3.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=

WORKSPACE_BUILD_JOBS=2
WORKSPACE_PARSE_WORKERS=3
RUNTIME_MANIFEST_AI_FALLBACK=true

# -----------------------------------------------------------------------------
# Auth0 / OIDC
# -----------------------------------------------------------------------------
AUTH_MODE=oidc
OIDC_ISSUER=https://your-tenant.auth0.com/
OIDC_AUDIENCE=https://api.testforge.example.com
OIDC_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json

# Local development authentication only. Never deploy these values.
AUTH_ALLOW_INSECURE_DEVELOPMENT=false
AUTH_DEVELOPMENT_TOKEN=
AUTH_DEVELOPMENT_USER_EMAIL=developer@testforge.local

# -----------------------------------------------------------------------------
# Source-control OAuth (separate applications from Auth0 social login)
# -----------------------------------------------------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# PostHog
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Cost and concurrency controls
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=86400
RATE_LIMIT_REPOSITORY_INDEX_DAILY=5
RATE_LIMIT_AI_GENERATION_DAILY=30
RATE_LIMIT_PROJECT_CHAT_DAILY=60
RATE_LIMIT_DOCUMENT_UPLOAD_DAILY=10
RATE_LIMIT_PREVIEW_CREATION_DAILY=5
RATE_LIMIT_PREVIEW_EXTENSION_DAILY=20
RATE_LIMIT_BROWSER_SESSION_DAILY=20
RATE_LIMIT_SCREENSHOT_DAILY=50
CONCURRENCY_LIMIT_PREVIEWS_PER_USER=1
CONCURRENCY_LIMIT_BROWSER_SESSIONS_PER_USER=1
CONCURRENCY_LIMIT_TTL_SECONDS=172800

# -----------------------------------------------------------------------------
# Preview workers. Trusted local execution must remain false in production.
# -----------------------------------------------------------------------------
PREVIEW_TRUSTED_LOCAL_EXECUTION=false
PREVIEW_PUBLIC_HOST=127.0.0.1
PREVIEW_HEALTH_HOST=127.0.0.1
PREVIEW_RECONCILE_SECONDS=15
PREVIEW_GIT_IMAGE=alpine/git:v2.47.2
PREVIEW_NODE_IMAGE_PREFIX=node

# -----------------------------------------------------------------------------
# Frontend (Vite/Vercel). Every VITE_* value is public and baked into the build.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTH_MODE=oidc
VITE_AUTH_DEVELOPMENT_TOKEN=
VITE_OIDC_AUTHORITY=https://your-tenant.auth0.com/
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=https://api.testforge.example.com
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_CONNECTION_PARAMETER=connection
VITE_OIDC_GITHUB_CONNECTION=github
VITE_OIDC_GOOGLE_CONNECTION=google-oauth2
VITE_OIDC_EMAIL_CONNECTION=Username-Password-Authentication
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Docker Compose-only local infrastructure
# -----------------------------------------------------------------------------
POSTGRES_DB=testforge
POSTGRES_USER=testforge
POSTGRES_PASSWORD=testforge-local
PGADMIN_DEFAULT_EMAIL=admin@testforge-local.com
PGADMIN_DEFAULT_PASSWORD=testforge-local
