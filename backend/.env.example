# Local development defaults
DATABASE_URL=sqlite:///backend/workspace/testforge.db
ARTIFACT_STORE=local
ARTIFACT_LOCAL_ROOT=backend/workspace/artifacts

# Build concurrency. Each build also uses WORKSPACE_PARSE_WORKERS parser threads.
WORKSPACE_BUILD_JOBS=2
WORKSPACE_PARSE_WORKERS=3
RUNTIME_MANIFEST_AI_FALLBACK=true

# Phase 2 preview execution (trusted local repositories only)
REDIS_URL=redis://127.0.0.1:6379/0
PREVIEW_TRUSTED_LOCAL_EXECUTION=false
PREVIEW_PUBLIC_HOST=127.0.0.1
# When the worker itself is containerized, use host.docker.internal.
PREVIEW_HEALTH_HOST=127.0.0.1
PREVIEW_RECONCILE_SECONDS=15
PREVIEW_GIT_IMAGE=alpine/git:v2.47.2
PREVIEW_NODE_IMAGE_PREFIX=node

# Per-user cost controls. Enabled by default; disabling is accepted only when
# APP_ENV is development, local, or test.
APP_ENV=production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=86400
RATE_LIMIT_REPOSITORY_INDEX_DAILY=5
RATE_LIMIT_AI_GENERATION_DAILY=30
RATE_LIMIT_PROJECT_CHAT_DAILY=60
RATE_LIMIT_DOCUMENT_UPLOAD_DAILY=10
RATE_LIMIT_PREVIEW_CREATION_DAILY=5
RATE_LIMIT_PREVIEW_EXTENSION_DAILY=20
RATE_LIMIT_BROWSER_SESSION_DAILY=20
RATE_LIMIT_SCREENSHOT_DAILY=50
CONCURRENCY_LIMIT_PREVIEWS_PER_USER=1
CONCURRENCY_LIMIT_BROWSER_SESSIONS_PER_USER=1
CONCURRENCY_LIMIT_TTL_SECONDS=172800

# Authentication. Production independently verifies signed OIDC access tokens.
AUTH_MODE=oidc
OIDC_ISSUER=https://your-identity-provider.example.com/
OIDC_AUDIENCE=https://api.testforge.example.com
OIDC_JWKS_URL=https://your-identity-provider.example.com/.well-known/jwks.json

# Source-control OAuth. These are separate from Auth0 social-login credentials.
# Generate the encryption key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_CALLBACK_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=

# Local development only. Never enable this mode in a deployed environment.
# AUTH_MODE=development
# AUTH_ALLOW_INSECURE_DEVELOPMENT=true
# AUTH_DEVELOPMENT_TOKEN=replace-with-a-local-random-value
# AUTH_DEVELOPMENT_USER_EMAIL=developer@testforge.local

# Production PostgreSQL example
# DATABASE_URL=postgresql://user:password@host:5432/testforge

# Production S3-compatible object storage (AWS S3, Supabase Storage, MinIO, etc.)
# ARTIFACT_STORE=s3
# ARTIFACT_S3_BUCKET=testforge-artifacts
# ARTIFACT_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# ARTIFACT_S3_REGION=us-east-1
# ARTIFACT_S3_ACCESS_KEY_ID=
# ARTIFACT_S3_SECRET_ACCESS_KEY=
